{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "test4test-redesign",
  "routes": [
    {
      "pattern": "test4test.io",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-03-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
