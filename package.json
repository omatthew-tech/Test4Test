    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tinacms": "^3.9.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
