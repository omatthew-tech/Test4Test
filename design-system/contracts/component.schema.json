{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test4test.io/design-system/component.schema.json",
  "title": "Test4Test component contract",
  "type": "object",
  "required": [
    "id",
    "name",
    "family",
    "version",
    "lifecycle",
    "source",
    "story",
    "storyExport",
    "exportName",
    "sizes",
    "variants",
    "states",
    "accessibleName",
    "controlMode",
    "examples",
    "semantics",
    "keyboard",
    "targetSize"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "family": {
      "enum": [
        "actions",
        "inputs",
        "navigation",
        "feedback",
        "overlays",
        "data-display",
        "layout",
        "product"
      ]
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "lifecycle": { "enum": ["experimental", "beta", "stable", "deprecated"] },
    "source": { "type": "string", "minLength": 1 },
    "story": { "type": "string", "minLength": 1 },
    "storyExport": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "exportName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "description": { "type": "string" },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "accessibleName": { "type": "string", "minLength": 1 },
    "controlMode": {
      "enum": ["controlled", "uncontrolled", "both", "not-applicable"]
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "semantics": { "type": "array", "items": { "type": "string" } },
    "keyboard": { "type": "array", "items": { "type": "string" } },
    "targetSize": { "type": "integer", "minimum": 44 },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
