{
  "id": "text-field",
  "name": "Text field",
  "family": "inputs",
  "version": "1.0.0",
  "lifecycle": "stable",
  "source": "design-system/components/inputs.tsx",
  "story": "design-system/stories/Inputs.stories.tsx",
  "description": "Labeled single-line text input with help and validation.",
  "semantics": [
    "Persistent label",
    "Help and error descriptions",
    "aria-invalid on error"
  ],
  "keyboard": [
    "Native text editing"
  ],
  "targetSize": 44,
  "dependencies": [
    "inline-validation"
  ],
  "exportName": "TextField",
  "sizes": [
    "default"
  ],
  "variants": [
    "text",
    "email",
    "url",
    "password",
    "search"
  ],
  "states": [
    "empty",
    "filled",
    "focus-visible",
    "disabled",
    "required",
    "help",
    "error"
  ],
  "accessibleName": "Required persistent label prop.",
  "controlMode": "both",
  "storyExport": "TextFieldContract",
  "examples": [
    "design-system/stories/Inputs.stories.tsx#TextFieldContract"
  ],
  "$schema": "../../contracts/component.schema.json"
}
