VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_TEST_ACCOUNT_EMAIL=test@test4test.io

# TinaCMS is only needed for deployed Tina Cloud editing.
# Local editing with `npm run dev:tina` works without these values.
TINA_PUBLIC_BRANCH=main
TINA_PUBLIC_CLIENT_ID=your_tina_client_id
TINA_TOKEN=your_tina_content_token

# Backward-compatible fallback if you still use the older Supabase anon-key naming.
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Set these as Supabase Edge Function secrets, not as client-side Vite env vars.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-mini
# SMTP2GO_API_KEY=your_smtp2go_api_key
# SMTP2GO_SENDER=no-reply@test4test.io
# APP_BASE_URL=https://test4test.io
# TEST_REPORT_SUPPORT_EMAIL=support@test4test.io
# TEST_ACCOUNT_ENABLED=true
# TEST_ACCOUNT_EMAIL=test@test4test.io
# TEST_ACCOUNT_PASSWORD=generate_a_strong_password
# TEST_ACCOUNT_OTP_CODE=123456
# VIDEO_PROCESSOR_URL=https://your-video-processor.example.com
# VIDEO_PROCESSOR_SHARED_SECRET=match_WORKER_SHARED_SECRET
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Seed script only. Use a service-role key locally; never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# TEST_ACCOUNT_SOURCE_EMAIL=matt.ozoroski@gmail.com
# TEST_ACCOUNT_PRODUCT_NAME=MastoMetrics
