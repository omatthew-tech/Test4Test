# ---------------------------------------------------------------------------
# Cloudflare R2 credentials (S3-compatible). Read strictly from the environment;
# never hardcode these values in source.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKET_NAME=usability-test-screenshots
# Full S3 API endpoint for your account, e.g.
# https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# Optional: bucket that stores the SOURCE recordings to download for processing.
# Defaults to CLOUDFLARE_BUCKET_NAME when omitted. Set this if your source
# videos live in a different bucket (e.g. test-response-recordings).
# ---------------------------------------------------------------------------
CLOUDFLARE_SOURCE_BUCKET_NAME=test-response-recordings

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=8787
# Shared secret required in the `x-worker-secret` header for job endpoints.
# Leave blank to disable auth (local development only).
WORKER_SHARED_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Frame extraction tuning (all optional, sensible defaults applied)
# ---------------------------------------------------------------------------
# Scene-change sensitivity 0..1 (lower = more scene cuts detected).
FRAME_SCENE_THRESHOLD=0.06
# Minimum seconds between two captured frames.
FRAME_MIN_GAP_SECONDS=0.25
# Max frames captured per source video (safety cap).
FRAME_MAX_PER_VIDEO=60
# Perceptual-hash Hamming distance below which two frames are "the same page"
# (lower = keep more near-duplicate frames).
FRAME_HAMMING_THRESHOLD=3
# Downsample the analysis-only pass before scene detection for faster reports.
FRAME_ANALYSIS_FPS=2
FRAME_ANALYSIS_WIDTH=480
# Also sample every N seconds (catches slow UI changes scene detection misses).
# 30s on a 6-min video yields ~12 interval points plus scene cuts.
FRAME_SAMPLE_INTERVAL_SECONDS=30
# Output image width in pixels (height keeps aspect ratio).
FRAME_OUTPUT_WIDTH=1280
# WebP quality 1..100.
FRAME_OUTPUT_QUALITY=80

# ---------------------------------------------------------------------------
# Groq transcription
# ---------------------------------------------------------------------------
# Required for uncached report transcription. Videos with no audio complete
# successfully with an empty transcript.
GROQ_API_KEY=your_groq_api_key
# Defaults to Groq's price/performance Whisper model.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional ISO-639-1 input language hint, e.g. en.
GROQ_TRANSCRIPTION_LANGUAGE=
# Optional context/spelling hint sent to Groq.
GROQ_TRANSCRIPTION_PROMPT=
# Optional safety controls for direct uploads and chunking.
GROQ_TRANSCRIPTION_MAX_UPLOAD_BYTES=20971520
GROQ_TRANSCRIPTION_CHUNK_SECONDS=600

# ---------------------------------------------------------------------------
# Optional completion webhook. When set, the worker POSTs the frame manifest
# to this URL after a job finishes (e.g. a Supabase Edge Function that writes
# usability_report_frames rows). The secret is sent as `x-worker-secret`.
# ---------------------------------------------------------------------------
COMPLETION_WEBHOOK_URL=https://your-project-id.supabase.co/functions/v1/complete-usability-report

# Dedicated Analytics preview queue. Thumbnail generation never runs report
# transcription and callbacks use the same x-worker-secret relationship.
THUMBNAIL_COMPLETION_WEBHOOK_URL=https://your-project-id.supabase.co/functions/v1/complete-recording-thumbnails
THUMBNAIL_GENERATION_VERSION=scene-after-half-v1
THUMBNAIL_JOB_CONCURRENCY=1
THUMBNAIL_QUEUE_MAX_PENDING=32
THUMBNAIL_MAX_BATCH_SIZE=16
