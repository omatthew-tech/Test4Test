{
  "name": "@test4test/video-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recording transcription and private MP4 clip processing with native FFmpeg.",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/mediaServer.js",
  "scripts": {
    "dev": "tsx watch src/mediaServer.ts",
    "start": "node dist/mediaServer.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "validate:quotes": "tsx scripts/validate-quote-matching.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "fluent-ffmpeg": "2.1.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/fluent-ffmpeg": "2.1.27",
    "@types/node": "22.7.4",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
