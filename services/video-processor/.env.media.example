# For the media-only npm/Docker entrypoint. Never commit actual credentials.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_BUCKET_NAME=test-response-recordings
CLOUDFLARE_SOURCE_BUCKET_NAME=test-response-recordings
CLOUDFLARE_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
PORT=8787
WORKER_SHARED_SECRET=replace-with-existing-supabase-worker-secret
GROQ_API_KEY=your_groq_api_key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPT_COMPLETION_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/complete-recording-transcript
CLIP_COMPLETION_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/complete-recording-clip
# Only used to preserve explicit source-deletion cleanup for existing images.
THUMBNAIL_BUCKET_NAME=usability-test-screenshots
